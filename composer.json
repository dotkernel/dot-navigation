{
    "name": "dotkernel/dot-navigation",
    "type": "library",
    "description": "Dotkernel navigation component, for any PSR-11 container",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-navigation",
    "keywords": [
        "navigation",
        "factories",
        "container",
        "laminas",
        "mezzio"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "dotkernel/dot-authorization": "^3.4.1",
        "dotkernel/dot-helpers": "^3.7.0",
        "laminas/laminas-escaper": "^2.13.0",
        "laminas/laminas-stdlib": "^3.22",
        "mezzio/mezzio-router": "^4.0",
        "mezzio/mezzio-template": "^2.13.0 || ^3.1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5.22"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Navigation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Navigation\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
